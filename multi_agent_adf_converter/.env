# =============================================================================
# ADF to Databricks Lakeflow Multi-Agent Converter - Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# LLM Configuration (REQUIRED)
# =============================================================================
# Your LLM API key (e.g., OpenAI, Azure OpenAI, or Capgemini Generative Engine)
LLM_API_KEY="your-api-key-here"

# LLM Model name
LLM_MODEL="openai.gpt-5-mini"

# LLM API base URL
LLM_BASE_URL="https://openai.generative.engine.capgemini.com/v1"

# =============================================================================
# Azure Service Principal Credentials (for live ADF scanning)
# =============================================================================
# If you don't have these, you can use --cached-json to load a pre-scanned file
AZURE_TENANT_ID="your-tenant-id"
AZURE_CLIENT_ID="your-client-id"
AZURE_CLIENT_SECRET="your-client-secret"
AZURE_SUBSCRIPTION_ID="your-subscription-id"
AZURE_RESOURCE_GROUP="your-resource-group"
AZURE_ADF_FACTORY="your-adf-factory-name"

# =============================================================================
# Output & Cache Configuration
# =============================================================================
OUTPUT_DIR="output"
CACHE_DIR="cache"
MAX_RETRIES=3
LOG_LEVEL="INFO"
